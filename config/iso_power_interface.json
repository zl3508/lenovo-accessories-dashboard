{
  "interface_name": "iso_power_dashboard_import",
  "version": "1.0.0",
  "source_format": "xlsx",
  "source_storage": "Excel PivotCache XML",
  "source_detection": "field_signature",
  "datasets": {
    "power_shipments": {
      "required_fields": [
        "Country",
        "Part Number",
        "Fiscal Year",
        "Fiscal Quarter",
        "Ship_Rev",
        "Ship_Qty",
        "Ship_AUR",
        "KEY Category"
      ],
      "filter": {
        "field": "KEY Category",
        "operator": "normalized_exact_match",
        "value": "Power"
      },
      "canonical_fields": {
        "fiscal_year": "Fiscal Year",
        "fiscal_quarter": "Fiscal Quarter",
        "period": "Quarter",
        "half_year": "Half Year",
        "geo": "Geo",
        "sub_geo": "New SubGeo",
        "country": "Country",
        "segment": "Segment",
        "bu_segment": "BU Segment",
        "bpc_segment": "BPC Segment",
        "sub_segment": "New Sub-Segment",
        "distribution_channel": "Distribution_channel",
        "channel": "New Channel",
        "category_1": "Category 1",
        "category_2": "Category 2",
        "category_3": "Category 3",
        "key_category": "KEY Category",
        "part_number": "Part Number",
        "model": "Model",
        "description": "Description",
        "dib": "DIB",
        "new_business": "New Biz",
        "ship_revenue": "Ship_Rev",
        "ship_quantity": "Ship_Qty",
        "ship_aur": "Ship_AUR"
      },
      "derived_fields": {
        "period_key": "concat('FY', Fiscal Year, apostrophe, Fiscal Quarter)",
        "calculated_ship_aur": "Ship_Rev / Ship_Qty when Ship_Qty != 0"
      },
      "ignored_helper_fields": [
        "Ship_Rev (M)",
        "Ship_Qty (K)",
        "YOGA(\u8fc7\u7a0b\u5217)"
      ]
    },
    "power_partner_sales": {
      "required_fields": [
        "Fiscal Year",
        "Fiscal Qtr",
        "Geo",
        "PN",
        "Ship CA",
        "Ship Rev",
        "Partner",
        "SoldtoCustomer",
        "Key Category"
      ],
      "filter": {
        "field": "Key Category",
        "operator": "normalized_exact_match",
        "value": "Power"
      },
      "usage": "partner and customer analysis only; do not use as the top-line shipment total"
    },
    "power_adoption_rate": {
      "required_fields": [
        "GEO",
        "Segment",
        "Category",
        "Quarter",
        "Rate"
      ],
      "filter": {
        "field": "Category",
        "operator": "normalized_exact_match",
        "values": [
          "Power",
          "< Power > AR"
        ]
      },
      "usage": "Power attachment/adoption rate by geo, segment and fiscal quarter"
    }
  },
  "update_policy": {
    "mode": "full_snapshot_rebuild",
    "fallback_mode": "replace_period_partitions",
    "period_partition": [
      "fiscal_year",
      "fiscal_quarter"
    ],
    "filename_is_not_part_of_interface": true,
    "sheet_position_is_not_part_of_interface": true,
    "pivot_cache_number_is_not_part_of_interface": true
  },
  "validation": {
    "required": [
      "all required field signatures are present",
      "Power record count is greater than zero",
      "part_number is nonblank for shipment rows",
      "Ship_Rev and Ship_Qty are numeric",
      "Ship_AUR equals Ship_Rev / Ship_Qty within absolute tolerance 0.01 when quantity is nonzero",
      "period_key can be built from fiscal year and quarter"
    ],
    "warnings": [
      "new or renamed Category 2 values",
      "new geographies or countries",
      "adoption-rate data missing for the latest shipment quarter",
      "partner-sales total does not reconcile to top-line shipments"
    ]
  }
}
